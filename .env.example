# =============================================================================
# PySpark + Jupyter Lab environment configuration
# =============================================================================

# Port to expose Jupyter Lab on (default: 8888)
JUPYTER_PORT=8888

# Jupyter Lab access token
JUPYTER_TOKEN=pyspark

# Memory available to Spark (driver JVM heap, default: 1g). Increase it
# (e.g. 2g, 4g) for larger datasets, keeping it below the memory assigned to
# Docker. Restart the kernel after changing it.
SPARK_DRIVER_MEMORY=1g
